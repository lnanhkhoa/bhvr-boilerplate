# Server Configuration
PORT=5100
NODE_ENV=development

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars-long!!

# Database (PostgreSQL)
# For Docker setup (recommended for local development)
DATABASE_URL=postgresql://bhvr:bhvr_dev_password@localhost:5432/bhvr_dev

# For production or managed databases (Neon, Supabase, etc.)
# DATABASE_URL=postgresql://username:password@host:5432/database_name
# DIRECT_URL=your_direct_connection_string_here

# OAuth Providers

# Google OAuth
GOOGLE_CLIENT_ID= #your-google-client-id
GOOGLE_CLIENT_SECRET= #your-google-client-secret

# GitHub OAuth  
GITHUB_CLIENT_ID= #your-github-client-id
GITHUB_CLIENT_SECRET= #your-github-client-secret

# Email Configuration (Optional - for email verification)
RESEND_API_KEY= #re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Your App <noreply@yourapp.com>"

# Application URLs
APP_URL=http://localhost:5101
API_URL=http://localhost:5100